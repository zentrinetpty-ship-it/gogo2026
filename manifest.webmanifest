{
  "name": "GOGO - Smart Hike, Zero Queue",
  "short_name": "GOGO",
  "description": "Long-distance seats and parcels, door to door. We collect you at your gate and drive you town to town.",
  "id": "/gogo/",
  "start_url": "/gogo/",
  "scope": "/gogo/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "theme_color": "#FFFFFF",
  "background_color": "#1A1A1A",
  "lang": "en-ZA",
  "dir": "ltr",
  "categories": [
    "travel",
    "navigation",
    "productivity"
  ],
  "icons": [
    {
      "src": "/gogo/assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/gogo/assets/icons/icon-384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/gogo/assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/gogo/assets/icons/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/gogo/assets/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Find a ride",
      "short_name": "Rides",
      "description": "Browse hikes leaving soon",
      "url": "/gogo/rides.html"
    },
    {
      "name": "Send a parcel",
      "short_name": "Parcel",
      "description": "Put a parcel in a boot already heading there",
      "url": "/gogo/parcel.html"
    },
    {
      "name": "My trips",
      "short_name": "Trips",
      "description": "Your bookings and their status",
      "url": "/gogo/dashboard.html"
    }
  ]
}
